{
  "name": "pr-agent",
  "version": "0.1.0",
  "description": "Autonomous Agentic Code Review PR Agent with Self-developed Runtime and OpenTelemetry/Phoenix Observability",
  "license": "MIT",
  "bin": {
    "pr-agent": "./dist/cli.mjs"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "tsc -p .",
    "lint": "vp lint",
    "format": "vp fmt",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "^0.1.0",
    "@ast-grep/napi": "^0.28.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-rest-endpoint-methods": "^13.3.0",
    "@octokit/rest": "^21.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@vscode/ripgrep": "^1.18.0",
    "bullmq": "^6.3.16",
    "c12": "4.0.0-rc.2",
    "commander": "^13.1.0",
    "gitdiff-parser": "^0.3.1",
    "ioredis": "^6.0.0",
    "jiti": "^2.7.0",
    "js-tiktoken": "^1.0.17",
    "openai": "^4.86.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite-plus": "catalog:"
  }

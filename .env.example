# ===================================================
# PR-Agent Docker Deployment Environment Template
# ===================================================

# 1. DeepSeek API Credentials
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
PR_AGENT_MODEL="deepseek-flash"

# 2. GitHub App Credentials (Single-Tenant Private App)
#    `node scripts/create-github-app.ts --name <app-name>` creates the App and writes these three lines
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYourPrivateKeyHere\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your_webhook_hmac_secret"

# 3. Webhook Server Port (published on 127.0.0.1 only; GitHub reaches it through the tunnel)
PORT=3000

# 4. Concurrency & Rate Limiting (each concurrent review holds a checkout and an agent in memory)
MAX_CONCURRENT_REVIEWS=1
MAX_REVIEWS_PER_MINUTE=30

# 5. Wait for the head commit's CI before reviewing (ms); 0 reviews immediately
CI_WAIT_TIMEOUT_MS=900000
CI_POLL_INTERVAL_MS=60000

# 6. Cloudflare quick tunnel: the App's webhook URL follows the tunnel's current hostname.
#    Set to empty when a named tunnel serves a fixed hostname.
CLOUDFLARED_METRICS_URL=http://tunnel:2000

# 7. Container memory limit and observability (Phoenix runs only with --profile observability)
PR_AGENT_MEM_LIMIT=768m
PR_AGENT_TELEMETRY=false
